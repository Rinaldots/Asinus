<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asinus_sensors</name>
  <version>0.1.0</version>
  <description>Sensores do Asinus no Orange Pi 3B: IMU ICM-20948 (I2C) + GPS NEO-6M (UART) + fusao (madgwick/EKF/navsat)</description>
  <maintainer email="rinaldo.filho.095@ufrn.edu.br">Rinaldo Filho</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- I2C em Python. Se o rosdep nao achar a chave, use: pip install smbus2 -->
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>nmea_navsat_driver</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
